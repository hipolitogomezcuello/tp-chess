@startuml clases-dominio
' Diagrama de clases del dominio (misión 1.2).
' Nombres idénticos al código (en inglés); notas en español.
' Elementos marcados <<opcional>> pertenecen a la fase 7 (alcance opcional de la consigna).
title Dominio (chess::domain) — piezas, reglas, tablero y motor

set separator none
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members
skinparam class {
  BackgroundColor<<opcional>> #F5F5F5
  BorderColor<<opcional>> #9E9E9E
}

package "chess::domain" {

  ' ===================== Value objects =====================
  package "Value objects" {
    enum Color {
      White
      Black
    }
    note right of Color : función libre\nopposite(Color): Color

    class Position <<ValueObject>> {
      +Position(file: int, rank: int)
      +file(): int
      +rank(): int
      +operator+(Offset): Position
      +operator==(Position): bool
      +operator<(Position): bool
    }

    class Offset <<ValueObject>> {
      +Offset(dFile: int, dRank: int)
      +dFile(): int
      +dRank(): int
      +operator==(Offset): bool
    }

    class Directions <<utility>> {
      +{static} orthogonals(): vector<Offset>
      +{static} diagonals(): vector<Offset>
      +{static} all(): vector<Offset>
      +{static} knightJumps(): vector<Offset>
    }

    class BoardDimensions <<ValueObject>> {
      +BoardDimensions(files: int = 8, ranks: int = 8)
      +files(): int
      +ranks(): int
      +contains(Position): bool
      +operator==(BoardDimensions): bool
    }

    class PieceTypeId <<ValueObject>> {
      +PieceTypeId(value: string)
      +value(): const string&
      +operator==(PieceTypeId): bool
      +operator<(PieceTypeId): bool
    }

    enum MoveKind {
      Normal
      Capture
      DoublePawnPush
      EnPassant
      Castling
      Promotion
    }

    class Move <<ValueObject>> {
      +Move(from: Position, to: Position, kind: MoveKind = Normal)
      +from(): Position
      +to(): Position
      +kind(): MoveKind
      +{static} castling(kingFrom: Position, kingTo: Position, rookFrom: Position, rookTo: Position): Move
      +promotion(): optional<PieceTypeId>
      +rookFrom(): optional<Position>
      +rookTo(): optional<Position>
      +withPromotion(PieceTypeId): Move
      +operator==(Move): bool
    }
    note bottom of Move
      Misión 7.4 agrega:
      enPassant(from, to, capturedSquare),
      capturedSquare().
    end note

    enum GameStatus {
      InProgress
      Check
      Checkmate
      Stalemate
    }
  }

  ' ===================== Piezas (composición) =====================
  package "Piezas" {
    class PieceTraits <<struct>> {
      +isRoyal: bool = false
      +canCastleWith: bool = false
      +isPromotable: bool = false
    }

    class PieceDefinition <<no copiable>> {
      +PieceDefinition(id: PieceTypeId, symbol: char, rules: vector<unique_ptr<MovementRule>>, traits: PieceTraits)
      +id(): const PieceTypeId&
      +symbol(): char
      +rules(): const vector<unique_ptr<MovementRule>>&
      +traits(): const PieceTraits&
    }

    class Piece <<ValueObject>> {
      +Piece(definition: shared_ptr<const PieceDefinition>, color: Color, hasMoved: bool = false)
      +type(): const PieceTypeId&
      +color(): Color
      +symbol(): char
      +traits(): const PieceTraits&
      +definition(): const PieceDefinition&
      +hasMoved(): bool
      +withMoved(): Piece
      +operator==(Piece): bool
    }

    class PieceRegistry <<Registry>> {
      +add(definition: shared_ptr<const PieceDefinition>): void
      +find(id: PieceTypeId): shared_ptr<const PieceDefinition> (nullptr si no está)
      +contains(id: PieceTypeId): bool
      +promotableTypes(): vector<PieceTypeId>
    }

    class PieceFactory <<Factory>> {
      +PieceFactory(registry: const PieceRegistry&)
      +create(id: PieceTypeId, color: Color): Piece
    }

    class StandardPieces <<utility>> {
      +{static} kPawn: PieceTypeId
      +{static} kRook: PieceTypeId
      +{static} kKnight: PieceTypeId
      +{static} kBishop: PieceTypeId
      +{static} kQueen: PieceTypeId
      +{static} kKing: PieceTypeId
      +{static} registerAll(registry: PieceRegistry&): void
    }
  }

  ' ===================== Reglas de movimiento (Strategy) =====================
  package "Reglas de movimiento" {
    interface MovementRule <<Strategy>> {
      +{abstract} candidateMoves(ctx: const MoveContext&): vector<Move>
      +{abstract} attackedSquares(ctx: const MoveContext&): vector<Position>
      +~MovementRule()
    }

    class MoveContext {
      +MoveContext(state: const GameState&, from: Position)
      +state(): const GameState&
      +board(): const Board&
      +from(): Position
      +piece(): const Piece&
    }

    class SlidingRule {
      +SlidingRule(directions: vector<Offset>)
    }
    class LeaperRule {
      +LeaperRule(offsets: vector<Offset>)
    }
    class PawnRule {
      +PawnRule()
    }
    class RuleHelpers <<utility>> {
      +{static} movesOntoReachableSquares(ctx: const MoveContext&, squares: vector<Position>): vector<Move>
    }
    note bottom of RuleHelpers
      Función libre (no es una clase en C++).
      Vacía → Normal, enemiga → Capture,
      propia → se descarta.
    end note
    class CastlingRule {
      +candidateMoves(ctx: const MoveContext&): vector<Move>
      +attackedSquares(ctx: const MoveContext&): vector<Position>
    }
    note bottom of CastlingRule
      Solo geometría: rey y pieza canCastleWith
      sin mover y casillas libres entre ellos.
      El jaque lo mira LegalMoveFilter (D-07).
      attackedSquares = {} (no captura).
    end note
  }

  ' ===================== Tablero y estado =====================
  package "Tablero y estado" {
    class Board {
      +Board(dimensions: BoardDimensions)
      +dimensions(): const BoardDimensions&
      +pieceAt(Position): optional<Piece>
      +isEmpty(Position): bool
      +place(Position, Piece): void
      +remove(Position): void
      +move(from: Position, to: Position): void
      +positionsOf(Color): vector<Position>
    }

    interface StartingPositionProvider <<Strategy>> {
      +{abstract} createInitialBoard(factory: const PieceFactory&): Board
      +~StartingPositionProvider()
    }
    class StandardStartingPosition

    class GameState <<Memento>> {
      +GameState(board: Board, sideToMove: Color = White, enPassantTarget: optional<Position> = nullopt)
      +board(): const Board&
      +sideToMove(): Color
      +enPassantTarget(): optional<Position>
    }
  }

  ' ===================== Motor de reglas =====================
  package "Motor de reglas" {
    class RulesEngine <<Facade>> <<no copiable>> {
      +RulesEngine(registry: const PieceRegistry&)
      +legalMoves(state: const GameState&, from: Position): vector<Move>
      +apply(state: const GameState&, move: const Move&): GameState
      +status(state: const GameState&): GameStatus
      +canPromoteTo(type: const PieceTypeId&): bool
      +promotionChoices(color: Color): vector<Piece>
    }
    note right of RulesEngine
      Crea la PieceFactory a partir del registro.
      La promoción la valida el trait isPromotable
      (D-08): una pieza nueva promovible no toca
      ni PawnRule ni el motor.
    end note

    class MoveGenerator {
      +movesFrom(state: const GameState&, from: Position): vector<Move>
      +allMoves(state: const GameState&): vector<Move>
    }

    class AttackDetector {
      +isSquareAttacked(state: const GameState&, square: Position, byColor: Color): bool
      +isInCheck(state: const GameState&, color: Color): bool
    }

    class MoveApplier {
      +MoveApplier(factory: const PieceFactory&)
      +apply(state: const GameState&, move: const Move&): GameState
    }
    note bottom of MoveApplier
      Con promotion() elegida crea la pieza
      nueva con la PieceFactory. En el enroque
      mueve también la torre. Misión 7.4: al paso.
    end note

    class LegalMoveFilter {
      +LegalMoveFilter(applier: const MoveApplier&, detector: const AttackDetector&)
      +filter(state: const GameState&, moves: vector<Move>): vector<Move>
      -leavesOwnKingSafe(state: const GameState&, move: const Move&): bool
      -kingPathIsSafe(state: const GameState&, castling: const Move&): bool
    }

    class GameStatusEvaluator {
      +GameStatusEvaluator(detector: const AttackDetector&, generator: const MoveGenerator&, filter: const LegalMoveFilter&)
      +evaluate(state: const GameState&): GameStatus
      -hasLegalMoves(state: const GameState&): bool
    }
    note bottom of GameStatusEvaluator
      ¿En jaque? × ¿tiene jugadas legales?
      → InProgress, Check, Checkmate o Stalemate.
    end note
  }
}

' ===================== Relaciones =====================
' Value objects
Position ..> Offset : se suma a
Directions ..> Offset : crea
BoardDimensions ..> Position : contains
Move "1" *-- "2" Position
Move "1" *-- "1" MoveKind
Move "1" o-- "0..1" PieceTypeId : promotion
Move "1" o-- "0..2" Position : rookFrom / rookTo

' Piezas
PieceDefinition "1" *-- "1" PieceTypeId
PieceDefinition "1" *-- "1" PieceTraits
PieceDefinition "1" *-- "1..*" MovementRule : rules
Piece "0..*" --> "1" PieceDefinition : comparte (shared_ptr)
Piece "1" *-- "1" Color
PieceRegistry "1" o-- "0..*" PieceDefinition
PieceFactory "1" --> "1" PieceRegistry : consulta
PieceFactory ..> Piece : crea
StandardPieces ..> PieceRegistry : registra
StandardPieces ..> SlidingRule : compone
StandardPieces ..> LeaperRule : compone
StandardPieces ..> PawnRule : compone
StandardPieces ..> CastlingRule : compone
StandardPieces ..> Directions

' Strategy
MovementRule <|.. SlidingRule
MovementRule <|.. LeaperRule
MovementRule <|.. PawnRule
MovementRule <|.. CastlingRule
SlidingRule ..> RuleHelpers : usa
LeaperRule ..> RuleHelpers : usa
MovementRule ..> MoveContext : lee
MovementRule ..> Move : genera
MoveContext "1" --> "1" GameState

' Tablero y estado
Board "1" *-- "1" BoardDimensions
Board "1" *-- "0..*" Piece : casillas (optional<Piece>)
GameState "1" *-- "1" Board
GameState "1" *-- "1" Color : sideToMove
StartingPositionProvider <|.. StandardStartingPosition
StartingPositionProvider ..> PieceFactory : usa
StartingPositionProvider ..> Board : crea

' Motor
RulesEngine "1" --> "1" PieceRegistry : promotableTypes
RulesEngine "1" *-- "1" PieceFactory
RulesEngine "1" *-- "1" MoveGenerator
RulesEngine "1" *-- "1" AttackDetector
RulesEngine "1" *-- "1" MoveApplier
RulesEngine "1" *-- "1" LegalMoveFilter
RulesEngine "1" *-- "1" GameStatusEvaluator
RulesEngine ..> GameStatus
MoveGenerator ..> MovementRule : recorre las reglas de la pieza
AttackDetector ..> MovementRule : attackedSquares
MoveApplier "1" --> "1" PieceFactory : promoción
LegalMoveFilter "1" --> "1" MoveApplier
LegalMoveFilter "1" --> "1" AttackDetector
LegalMoveFilter ..> CastlingRule : "condición de jaque\ndel enroque (D-07)"
GameStatusEvaluator "1" --> "1" AttackDetector
GameStatusEvaluator "1" --> "1" MoveGenerator : allMoves
GameStatusEvaluator "1" --> "1" LegalMoveFilter

' ===================== Notas de patrones =====================
note top of MovementRule
  **Strategy** (arquitectura §3.2)
  Cada forma de moverse es un algoritmo
  intercambiable. La Reina = SlidingRule(all).
  attackedSquares ≠ candidateMoves: el peón
  ataca en diagonal pero avanza recto.
end note

note bottom of PieceDefinition
  **Composición sobre herencia** (§3.3)
  No existen Rook, Knight… como subclases.
  Una pieza = id + símbolo + reglas + traits.
  Agregar el Arzobispo = registrar
  {SlidingRule(diagonals), LeaperRule(knightJumps)}.
end note

note right of PieceRegistry
  **Factory + Registry** (§3.4)
  PieceTypeId es abierto (string):
  agregar un tipo = add(), sin switch.
end note

note bottom of StartingPositionProvider
  **Strategy** (§3.5)
  Tablero 10×10 o Chess960 = otra
  implementación. Board y el motor
  solo usan BoardDimensions.
end note

note top of RulesEngine
  **Facade** (§3.6)
  La aplicación solo ve legalMoves / apply / status.
  Pipeline interno: MoveGenerator → LegalMoveFilter
  (MoveApplier + AttackDetector) → GameStatusEvaluator.
end note

note bottom of AttackDetector
  isInCheck busca la pieza con
  traits.isRoyal, no "el rey".
end note

note bottom of GameState
  Value object copiable: sirve de
  **Memento** para deshacer (§3.8).
  Los derechos de enroque se derivan
  de Piece::hasMoved (ver D-06).
end note
@enduml
