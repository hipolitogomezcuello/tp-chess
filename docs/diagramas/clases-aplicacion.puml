@startuml clases-aplicacion
' Diagrama de clases de aplicación, puertos y adaptadores (misión 1.3, actualizado en la 7.7).
title Aplicación, puertos y adaptadores

set separator none
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members

' ===================== Puertos =====================
package "chess::ports" {
  interface GameService <<Port>> {
    +{abstract} makeMove(from: Position, to: Position, promotion: optional<PieceTypeId> = nullopt): MoveResult
    +{abstract} legalMovesFrom(from: Position): vector<Move>
    +{abstract} state(): const GameState&
    +{abstract} status(): GameStatus
    +{abstract} promotionChoices(): vector<Piece>
    +{abstract} undo(): bool
    +{abstract} redo(): bool
    +{abstract} addObserver(observer: GameObserver&): void
  }

  interface GameObserver <<Port>> <<Observer>> {
    +{abstract} onMoveMade(move: const Move&, state: const GameState&): void
    +{abstract} onCheck(colorInCheck: Color): void
    +{abstract} onGameOver(result: GameStatus, sideToMove: Color): void
    +{abstract} onUndoRedo(state: const GameState&): void
  }

  class MoveResult <<ValueObject>> {
    +{static} success(move: Move): MoveResult
    +{static} failure(error: MoveError): MoveResult
    +ok(): bool
    +error(): optional<MoveError>
    +move(): const optional<Move>&
  }

  enum MoveError {
    NoPieceAtOrigin
    NotYourTurn
    IllegalMove
    GameOver
    PromotionRequired
    InvalidPromotion
  }
}

' ===================== Aplicación =====================
package "chess::application" {
  class ChessGame {
    +ChessGame(rules: const RulesEngine&, initialState: GameState)
    -- GameService --
    +makeMove(from: Position, to: Position, promotion: optional<PieceTypeId> = nullopt): MoveResult
    +legalMovesFrom(from: Position): vector<Move>
    +state(): const GameState&
    +status(): GameStatus
    +promotionChoices(): vector<Piece>
    +undo(): bool
    +redo(): bool
    +addObserver(observer: GameObserver&): void
    -- para las fases --
    +performMove(from: Position, to: Position, promotion: const optional<PieceTypeId>&): MoveResult
    -- privados --
    -hasPieceOfSideToMove(from: Position): bool
    -withPromotionChoice(move: const Move&, promotion: const optional<PieceTypeId>&): MoveResult
    -updatePhase(): void
    -notifyAfterMove(move: const Move&): void
    -notifyUndoRedo(): void
  }

  interface GamePhase <<State>> {
    +{abstract} tryMove(game: ChessGame&, from: Position, to: Position, promotion: const optional<PieceTypeId>&): MoveResult
    +~GamePhase()
  }
  class InProgressPhase {
    +tryMove(game: ChessGame&, from: Position, to: Position, promotion: const optional<PieceTypeId>&): MoveResult
  }
  class GameOverPhase {
    +tryMove(game: ChessGame&, from: Position, to: Position, promotion: const optional<PieceTypeId>&): MoveResult
  }

  class MoveCommand <<Command>> {
    +MoveCommand(rules: const RulesEngine&, move: Move)
    +execute(state: GameState&): void
    +undo(state: GameState&): void
    +move(): const Move&
    -before_: optional<GameState>
  }

  class MoveHistory {
    +record(executed: MoveCommand): void
    +undo(state: GameState&): bool
    +redo(state: GameState&): bool
    +canUndo(): bool
    +canRedo(): bool
  }
}

' ===================== Dominio (solo lo que se usa) =====================
package "chess::domain" {
  class RulesEngine <<Facade>> {
    +legalMoves(state, from): vector<Move>
    +apply(state, move): GameState
    +status(state): GameStatus
    +canPromoteTo(type): bool
    +promotionChoices(color): vector<Piece>
  }
  class GameState <<Memento>>
  class Move
  enum GameStatus
}

' ===================== Adaptadores =====================
package "chess::adapters::console" {
  class ConsoleUI <<Adapter>> {
    +ConsoleUI(game: GameService&, in: istream&, out: ostream&)
    +run(): void
    -execute(words: const vector<string>&): bool
    -makeMove(fromText: const string&, toText: const string&, promotionText: const string& = ""): void
    -findPromotionChoice(text: const string&): optional<PieceTypeId>
    -promotionChoicesText(): string
    -showMoves(squareText: const string&): void
    -showHelp(): void
    -reportError(result: const MoveResult&, fromText, toText): void
  }
  class ConsoleRenderer <<Adapter>> {
    +ConsoleRenderer(out: ostream&)
    +render(state: const GameState&): void
    +onMoveMade(move: const Move&, state: const GameState&): void
    +onCheck(colorInCheck: Color): void
    +onGameOver(result: GameStatus, sideToMove: Color): void
    +onUndoRedo(state: const GameState&): void
  }
  class AlgebraicNotation <<utility>> {
    +{static} parse(text: string_view, dims: const BoardDimensions&): optional<Position>
    +{static} format(position: Position): string
  }
}

package "chess::adapters::raylib" {
  class RaylibUI <<Adapter>> {
    +run(game: GameService&): void
    +onMoveMade(move: const Move&, state: const GameState&): void
    +onCheck(colorInCheck: Color): void
    +onGameOver(result: GameStatus, sideToMove: Color): void
    +onUndoRedo(state: const GameState&): void
    -lastMove_: optional<Move>
    -message_: string
  }
  class BoardInteraction {
    +BoardInteraction(game: GameService&)
    +click(square: Position): void
    +choosePromotion(type: const PieceTypeId&): void
    +cancel(): void
    +undo(): bool
    +redo(): bool
    +selected(): const optional<Position>&
    +highlightedMoves(): const vector<Move>&
    +awaitingPromotion(): bool
    +promotionChoices(): vector<Piece>
  }
  class BoardLayout {
    +BoardLayout(dimensions: BoardDimensions, originX: int, originY: int, boardPixels: int)
    +squareSize(): int
    +topLeftOf(position: Position): Point
    +squareAt(x: int, y: int): optional<Position>
  }
}

' ===================== Relaciones =====================
GameService <|.. ChessGame
GameObserver <|.. ConsoleRenderer
GameObserver <|.. RaylibUI
GameService ..> MoveResult
MoveResult "1" *-- "0..1" MoveError
GameService ..> GameObserver : addObserver

ChessGame "1" --> "1" RulesEngine : usa
ChessGame "1" *-- "1" GameState : estado actual
ChessGame "1" *-- "1" MoveHistory
ChessGame ..> MoveCommand : crea y ejecuta
ChessGame "1" *-- "1" GamePhase : fase actual (unique_ptr)
ChessGame "1" o-- "0..*" GameObserver : notifica
GamePhase <|.. InProgressPhase
GamePhase <|.. GameOverPhase
InProgressPhase ..> ChessGame : performMove
GameOverPhase ..> MoveResult : failure(GameOver)
MoveHistory "1" *-- "0..*" MoveCommand : pilas undo/redo
MoveCommand "1" --> "1" RulesEngine : apply
MoveCommand "1" *-- "0..1" GameState : estado previo (Memento)
MoveCommand "1" *-- "1" Move

ConsoleUI "1" --> "1" GameService : usa
ConsoleUI ..> AlgebraicNotation
ConsoleRenderer ..> AlgebraicNotation : format
ConsoleUI ..> MoveResult : traduce MoveError a texto
RaylibUI ..> BoardInteraction : crea en run()
RaylibUI ..> BoardLayout : píxel ↔ casilla
BoardInteraction "1" --> "1" GameService : usa

' ===================== Notas =====================
note top of GameService
  **Puerto de entrada** (driving, §3.1).
  Los adaptadores solo conocen esta interfaz,
  nunca ChessGame ni el RulesEngine.
end note

note top of GameObserver
  **Observer** — puerto de salida (§3.9).
  El núcleo avisa sin saber quién escucha.
end note

note bottom of GamePhase
  **State** (§3.7). InProgressPhase delega en
  ChessGame::performMove; GameOverPhase
  rechaza con MoveError::GameOver.
  updatePhase() la elige según el GameStatus
  después de cada cambio de estado (D-10).
end note

note bottom of MoveCommand
  **Command + Memento** (§3.8).
  execute guarda el GameState previo;
  undo lo restaura; rehacer = execute
  otra vez. Una jugada nueva vacía la
  pila de rehacer (MoveHistory).
end note

note bottom of BoardInteraction
  Qué significa cada click, sin raylib
  (se testea sin ventana): seleccionar,
  mover, esperar la pieza de la promoción.
end note

note right of ChessGame
  Dependencias por constructor (§3.10).
  El composition root (app/) crea el
  PieceRegistry, el RulesEngine, el
  GameState inicial y los adaptadores.
end note
@enduml
