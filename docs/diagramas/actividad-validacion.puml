@startuml actividad-validacion
' Diagrama de actividad: pipeline de validación de un movimiento (misión 1.5, actualizado en la 7.7).
title Validación de una jugada — candidatos → pseudo-legales → legales → estado

skinparam shadowing false

legend top right
  Implementado completo (fases 3 a 7).
  Los chequeos de fase, origen, turno y promoción
  los hace ChessGame (aplicación); los pasos 1 a 4,
  el RulesEngine (dominio).
endlegend

start
:Llega makeMove(from, to, promotion);

if (¿la fase actual es GameOverPhase?) then (sí)
  :MoveResult::failure(GameOver);
  stop
endif
if (¿hay una pieza en from?) then (no)
  :MoveResult::failure(NoPieceAtOrigin);
  stop
endif
if (¿la pieza es del color que mueve?) then (no)
  :MoveResult::failure(NotYourTurn);
  stop
endif

partition "1. Candidatos (MovementRule — Strategy)" {
  :MoveContext(state, from);
  while (¿quedan reglas en piece.definition().rules()?) is (sí)
    :rule.candidateMoves(ctx)
    (SlidingRule, LeaperRule, PawnRule, CastlingRule…);
  endwhile (no)
}

partition "2. Pseudo-legales (MoveGenerator)" {
  :Unir los candidatos de todas las reglas
  (respetan tablero, bloqueos y capturas,
  pero **ignoran el jaque**);
}

partition "3. Filtro de jaque (LegalMoveFilter)" {
  while (¿quedan movimientos pseudo-legales?) is (sí)
    if (¿es Castling y el rey está en jaque\no cruza una casilla atacada? (D-07)) then (sí)
      :descartar;
    else (no)
      :copia = MoveApplier.apply(state, move)
      (no muta el estado original);
      if (AttackDetector.isInCheck(copia, color de la pieza)?) then (sí)
        :descartar;
      else (no)
        :conservar como legal;
      endif
    endif
  endwhile (no)
}

if (¿algún Move legal va a "to"?) then (no)
  :MoveResult::failure(IllegalMove);
  stop
endif

if (¿el Move es Promotion?) then (sí)
  if (¿vino promotion?) then (no)
    :MoveResult::failure(PromotionRequired);
    stop
  endif
  if (¿canPromoteTo(promotion)?\n(trait isPromotable, D-08)) then (no)
    :MoveResult::failure(InvalidPromotion);
    stop
  endif
  :move = move.withPromotion(promotion);
else (no)
  if (¿vino promotion?) then (sí)
    :MoveResult::failure(InvalidPromotion);
    stop
  endif
endif

:MoveCommand(rules, move).execute(state)
(guarda el Memento y aplica: enroque mueve la torre,
al paso saca al peón, la promoción crea la pieza);
:MoveHistory.record(command);

partition "4. Evaluación de estado (GameStatusEvaluator)" {
  :enJaque = AttackDetector.isInCheck(newState, newState.sideToMove());
  :hayJugadas = ¿algún movimiento legal
  para newState.sideToMove()?;
  if (hayJugadas?) then (sí)
    if (enJaque?) then (sí)
      :Check;
    else (no)
      :InProgress;
    endif
  else (no)
    if (enJaque?) then (sí)
      :Checkmate;
    else (no)
      :Stalemate;
    endif
  endif
}

:updatePhase() (Checkmate/Stalemate → GameOverPhase);
:Notificar observers (onMoveMade + onCheck u onGameOver)
y devolver MoveResult::success(move);
stop
@enduml
