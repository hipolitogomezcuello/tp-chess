@startuml secuencia-jugada
' Diagrama de secuencia: hacer una jugada (misión 1.4, actualizado en la 5.3).
' Refleja lo implementado. Los bloques "fase 7" (GamePhase, MoveHistory, promoción, fin de
' partida) son el diseño de los opcionales y todavía no existen en el código.
title Hacer una jugada — desde ConsoleUI hasta los observers

skinparam shadowing false
autonumber

actor Jugador
participant "ConsoleUI\n<<Adapter>>" as UI
participant "AlgebraicNotation" as AN
participant "GameService\n(ChessGame)" as Game
participant "GamePhase\n<<State>>\n«fase 7»" as Phase #F5F5F5
participant "RulesEngine\n<<Facade>>" as Rules
participant "MoveHistory\n«fase 7»" as History #F5F5F5
participant "GameObserver\n(ConsoleRenderer)" as Obs

Jugador -> UI : escribe "e2 e4"
UI -> AN : parse("e2", dims), parse("e4", dims)
AN --> UI : optional<Position> from, to
alt alguna casilla no se entiende
  UI -> Jugador : "casilla inválida"
else casillas válidas
  UI -> Game : makeMove(from, to)

  group fase 7 (State)
    Game -> Phase : tryMove(game, from, to, promotion)
    note right of Phase : GameOverPhase → failure(GameOver)\nInProgressPhase → game.performMove(...)
  end

  Game -> Game : ¿hay pieza en from?\n¿es del color que mueve?
  alt no hay pieza (o from fuera del tablero)
    Game --> UI : MoveResult::failure(NoPieceAtOrigin)
  else pieza del rival
    Game --> UI : MoveResult::failure(NotYourTurn)
  else pieza propia
    Game -> Rules : legalMoves(state, from)
    Rules --> Game : vector<Move> (ya sin las que dejan al rey en jaque)
    alt **jugada inválida**: ningún Move legal tiene destino "to"
      Game --> UI : MoveResult::failure(IllegalMove)
    else **jugada válida**
      group fase 7 (promoción)
        note over Game : Move de tipo Promotion sin promotion\no con !canPromoteTo → PromotionRequired | IllegalMove
      end
      Game -> Rules : apply(state, move)
      Rules --> Game : nuevo GameState
      Game -> Game : state_ = nuevo estado
      group fase 7 (Command + Memento)
        Game -> History : record(MoveCommand)
        note right of History : guarda el estado previo;\nvacía la pila de rehacer
      end
      Game -> Obs : onMoveMade(move, state)
      Game -> Rules : status(state)
      Rules --> Game : GameStatus
      opt status == Check
        Game -> Obs : onCheck(sideToMove)
      end
      group fase 7 (fin de partida)
        note over Game, Obs : updatePhase(); si Checkmate o Stalemate → onGameOver(status)
      end
      Game --> UI : MoveResult::success(move)
    end
  end

  alt result.ok()
    note over UI : el tablero ya lo dibujó\nel observer (onMoveMade)
  else error
    UI -> Jugador : muestra el motivo (MoveError)
  end
end
@enduml
